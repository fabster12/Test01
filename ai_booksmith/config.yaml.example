# AI Booksmith Configuration
# Copy this file to config.yaml and fill in your details.
# NOTE: Environment variables (e.g., OPENAI_API_KEY) will override values in this file.

# --- Provider Settings ---
provider: "mock" # "live" or "mock"

# --- Active Models ---
active_openai_model: "gpt-4o-mini"
active_leonardo_model: "flux_schnell"

# --- API Keys (used if environment variables are not set) ---
openai:
  api_key: "sk-your-openai-api-key-here"

leonardo:
  api_key: "your-leonardo-api-key-here"

# --- SSL Settings (used if environment variable is not set) ---
# Provide the full, absolute path to your company's custom SSL certificate file (.pem or .cer)
# Example: "C:/Users/YourUser/certs/company.pem"
ssl_cert_file: "" # e.g., "/path/to/your/certificate.pem"

# --- Flask Settings ---
flask:
  secret_key: "a-very-strong-and-random-secret-key-for-sessions"
