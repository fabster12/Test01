# AI Booksmith Configuration

# API Keys - Replace with your actual keys
# You can also set these as environment variables: OPENAI_API_KEY, LEONARDO_API_KEY
openai_api_key: "YOUR_OPENAI_API_KEY"
leonardo_api_key: "YOUR_LEONARDO_API_KEY"

# Flask secret key for session management
# You can also set this as an environment variable: FLASK_SECRET_KEY
flask_secret_key: "a-super-secret-key-that-you-should-change"

# Active AI Models - These should match the 'name' in models.yaml
# You can also set these as environment variables: ACTIVE_OPENAI_MODEL, ACTIVE_LEONARDO_MODEL
active_openai_model: "GPT-4o Mini"
active_leonardo_model: "Leonardo Diffusion XL"

# Path to the directory where generated books will be stored
# You can also set this as an environment variable: GENERATED_BOOKS_DIR
generated_books_dir: "generated_books"

# Optional: Path to your SSL certificate file for corporate networks
# You can also set this as an environment variable: SSL_CERT_FILE
ssl_cert_file: ""
